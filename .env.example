# =============================================================================
# gid-service environment configuration
# =============================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Every ${VAR} referenced in config.yaml MUST be defined here. configx uses
# os.ExpandEnv, so an unset var expands to "" — Load then rejects required
# fields via Validate.
#
# docker-compose: load via `env_file: .env` and mount config.yaml into
# /etc/gid-service/config.yaml (a default configx search path).
#
# NOTE: docker-compose `env_file` does NOT support inline `#` comments — keep
# all comments on their own line (as this file does).
#
# This service has no secrets; these are deploy parameters only.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
GID_SERVICE_SERVER_GRPC_ADDR=:19091
GID_SERVICE_SERVER_HTTP_ADDR=:18081

# -----------------------------------------------------------------------------
# Snowflake ID generator
# -----------------------------------------------------------------------------
# 1..65535, MUST be unique across instances
GID_SERVICE_SNOWFLAKE_MACHINE_ID=1
# project epoch; never change after the first ID is generated (RFC3339)
GID_SERVICE_SNOWFLAKE_START_TIME=2026-01-01T00:00:00Z

# Cron (scaffold-only; uncomment in config.yaml + here when wiring periodic jobs)
# CRON_TIMEZONE=Asia/Shanghai
# CRON_OVERLAP_POLICY=skip

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
GID_SERVICE_LOG_LEVEL=info
GID_SERVICE_LOG_FORMAT=json
